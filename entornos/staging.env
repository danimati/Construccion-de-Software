# Entorno de staging: copia de producción con datos controlados, en otros puertos.
# Uso: docker compose -p novakey-staging --env-file entornos/staging.env up -d --build
NOVAKEY_PERFIL=demo
NOVAKEY_HTTP_PUERTO=8081
NOVAKEY_HTTPS_PUERTO=8444
NOVAKEY_DB_PUERTO=5434
NOVAKEY_DIR_RESPALDOS=./respaldos-staging
NOVAKEY_WORKERS=2
NOVAKEY_DB_POOL=5
NOVAKEY_DB_OVERFLOW=5
